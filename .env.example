# Public, non-sensitive shared demo persistence. The publishable key is read only
# by the Node server; the browser never receives it from this application.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_PUBLIC_DEMO_MODE=true

# Production alternative (server only): set one secret key and remove the
# publishable/demo variables. Never commit or expose this value to the browser.
# SUPABASE_SECRET_KEY=sb_secret_your_server_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key
